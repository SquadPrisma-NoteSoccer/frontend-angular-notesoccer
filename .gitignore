# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
/node_modules/
#package-lock.json
/yarn.lock

# Environment files
/.env
src/assets/env.js

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# evita voltar arquivo de diff gerado local
/backup.patch

# 🧪 Cypress
# ==============================
cypress/videos/
cypress/screenshots/
cypress/reports/
cypress/downloads/
cypress/logs/
cypress/results/

# Ignore plugins temporários e cache
.cypress-cache/
.cypress/

